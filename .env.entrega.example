# Copiar a .env. Esta revision es la base v4.18.0; actualizar al commit que se construya.
SOURCE_REVISION=9f920b549c14491a4e587687a3eed5d21c6ccc7d
# Generar una clave hexadecimal aleatoria propia para la aplicacion.
SECRET_KEY_BASE=REPLACE_WITH_RANDOM_HEX
# Nombre del servicio en la red interna de Compose.
POSTGRES_HOST=postgres
POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=postgres
# Generar una contrasena propia; Compose la aplica tambien a PostgreSQL.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Conexion interna a Redis, sin publicar su puerto al host.
REDIS_URL=redis://redis:6379
# Generar una contrasena distinta de la usada para PostgreSQL.
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Direccion de acceso para el navegador en esta instalacion.
FRONTEND_URL=http://localhost:3001
# HTTP local para la prueba; revisar HTTPS antes de un despliegue publico.
FORCE_SSL=false
# Deshabilitar registro publico; el asistente permite crear la cuenta inicial.
ENABLE_ACCOUNT_SIGNUP=false
# Guardar adjuntos en el volumen storage_data.
ACTIVE_STORAGE_SERVICE=local
# Enviar registros a la salida del contenedor para consultarlos con compose logs.
RAILS_LOG_TO_STDOUT=true
